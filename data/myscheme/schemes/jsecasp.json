  "eligibilityCriteria": {
   "eligibilityDescription": [
    {
     "children": [
      {
       "children": [
        {
         "text": "The applicant should be a sportsperson."
        }
       ],
       "type": "list_item"
      },
      {
       "children": [
        {
         "text": "The Athletes must represent Jharkhand in competitions recognized by national/international Olympic committees."
        }
       ],
       "type": "list_item"
      },
      {
       "children": [
        {
         "text": "The Athletes must have secured a medal or participated in such competitions."
        }
       ],
       "type": "list_item"
      },
      {
       "children": [
        {
         "text": "The record-setting athletes are eligible for additional cash incentives."
        }
       ],
       "type": "list_item"
      },
      {
       "children": [
        {
         "text": "Awards for one competition are based on the highest achievement if multiple medals are won."
        }
       ],
       "type": "list_item"
      },
      {
       "children": [
        {
         "text": ""
        }
       ],
